{
  "name": "n8n-nodes-jackpotkeywords",
  "version": "0.1.0",
  "description": "n8n community node for JackpotKeywords — AI-powered keyword research, SEO audits, and AI-visibility (AEO) scans, backed by real Google Ads Keyword Planner data.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "jackpotkeywords",
    "keyword-research",
    "seo",
    "aeo",
    "ai-visibility"
  ],
  "license": "MIT",
  "homepage": "https://jackpotkeywords.web.app/developers",
  "author": {
    "name": "Michael Smith",
    "email": "smythmyke@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/smythmyke/JackpotKeywords.git"
  },
  "engines": {
    "node": ">=18.10"
  },
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "lint": "eslint nodes credentials package.json",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/JackpotKeywordsApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/JackpotKeywords/JackpotKeywords.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "n8n-workflow": "*",
    "typescript": "^5.7.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
