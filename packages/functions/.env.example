# Gemini AI
GEMINI_API_KEY=

# Google Ads API
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App
APP_URL=http://localhost:5000

# Async job worker (Zapier callback pattern). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JK_INTERNAL_JOB_SECRET=
INTERNAL_API_BASE=https://us-central1-even-plate-378520.cloudfunctions.net/api/api/v1
JK_JOB_CALLBACK_HOSTS=hooks.zapier.com,zapier.com

# RapidAPI marketplace surface. RapidAPI is the ledger (it meters + bills its own
# subscribers); JK resolves all RapidAPI traffic to one billing-exempt house
# account. Both must be set to enable the path; leave blank to disable.
#   JK_RAPIDAPI_PROXY_SECRET    — copy from the listing's Gateway > Firewall settings
#   JK_RAPIDAPI_HOUSE_CUSTOMER_ID — id printed by scripts/provision-rapidapi-house.mjs
JK_RAPIDAPI_PROXY_SECRET=
JK_RAPIDAPI_HOUSE_CUSTOMER_ID=
