# Gemini AI
GEMINI_API_KEY=

# Google Ads API
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# App
APP_URL=http://localhost:5000

# Async job worker (Zapier callback pattern). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JK_INTERNAL_JOB_SECRET=
INTERNAL_API_BASE=https://us-central1-even-plate-378520.cloudfunctions.net/api/api/v1
JK_JOB_CALLBACK_HOSTS=hooks.zapier.com,zapier.com

# RapidAPI marketplace surface. RapidAPI is the ledger (it meters + bills its own
# subscribers); JK resolves all RapidAPI traffic to one billing-exempt house
# account. Both must be set to enable the path; leave blank to disable.
#   JK_RAPIDAPI_PROXY_SECRET    — copy from the listing's Gateway > Firewall settings
#   JK_RAPIDAPI_HOUSE_CUSTOMER_ID — id printed by scripts/provision-rapidapi-house.mjs
JK_RAPIDAPI_PROXY_SECRET=
JK_RAPIDAPI_HOUSE_CUSTOMER_ID=

# x402 agent-payments pilot (roadmap X402-1a). Pay-per-call USDC-on-Base via
# Stripe's crypto PaymentIntent — no API key, no prepaid balance, no human
# checkout. Reuses STRIPE_SECRET_KEY above. See services/x402.ts and
# docs/api-deployment/X402-PILOT-PLAN-2026-06-02.md.
#   JK_X402_ENABLED      — master switch. Unset/0/false = route 404s (prod-safe
#                          default). Set to 1 ONLY after the Stripe account has
#                          the "Stablecoins and Crypto" payment method approved.
#   JK_X402_PRICE_CENTS  — per-call price override. Defaults to the recommend-deep
#                          price (30 = $0.30) when unset.
JK_X402_ENABLED=
JK_X402_PRICE_CENTS=

# PageSpeed Insights API key (SEO audit performance/Core Web Vitals checks).
# Free; create in GCP console, enable "PageSpeed Insights API", restrict the key to it.
PAGESPEED_API_KEY=

# WorkOS AuthKit — OAuth 2.1 for the remote MCP endpoint (Claude Connector Dir + OpenAI Apps).
# WORKOS_AUTHKIT_DOMAIN = your-project.authkit.app (issuer; JWKS = https://<domain>/oauth2/jwks)
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_AUTHKIT_DOMAIN=
